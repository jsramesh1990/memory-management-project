  "storage_settings": {
    "total_capacity_gb": 1000,
    "recording_retention_days": 30,
    "snapshot_retention_days": 30,
    "backup_enabled": true,
    "backup_schedule": "0 3 * * *",
    "storage_path": "/media/recordings",
    "snapshot_path": "/media/snapshots",
    "temp_path": "/tmp/nvr",
    "alert_on_full": true,
    "full_threshold_percent": 90
