  "network_settings": {
    "rtsp_port": 554,
    "http_port": 80,
    "https_port": 443,
    "websocket_port": 8888,
    "mqtt_port": 1883,
    "max_connections": 50,
    "connection_timeout": 30,
    "buffer_size": 4096
  },
  
  "notifications": {
    "methods": ["mqtt", "webhook", "email"],
    "mqtt_broker": "mqtt.local",
    "mqtt_port": 1883,
    "webhook_url": "http://homeassistant.local:8123/api/webhook/frigate",
    "email_smtp": "smtp.gmail.com",
