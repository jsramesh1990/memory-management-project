# Custom Board Configuration Template
# RK3568 DDR Memory Manager
# Version: 1.0.0
# Date: 2024-08-06

#
# Board Information (MODIFY THESE)
#
CONFIG_BOARD_NAME="My Custom Board"
CONFIG_BOARD_VENDOR="My Company"
CONFIG_BOARD_MODEL="Custom-001"
CONFIG_BOARD_REVISION="v0.1"

#
# SoC Configuration
#
CONFIG_SOC="RK3568"
CONFIG_ARCH="ARM64"
CONFIG_CPU_TYPE="Cortex-A55"
CONFIG_CPU_CORES=4
CONFIG_CPU_FREQ_MAX=2000
CONFIG_CPU_FREQ_MIN=408

#
# Memory Configuration (MODIFY BASED ON YOUR HARDWARE)
#
CONFIG_DDR_TYPE="LPDDR4"          # LPDDR4/DDR4/LPDDR4X
CONFIG_DDR_SIZE=2048              # 2GB/4GB/8GB
CONFIG_DDR_CHANNELS=1             # Single or Dual channel
CONFIG_DDR_FREQ=1600              # MHz (Check memory datasheet)
CONFIG_DDR_VOLTAGE=1100           # mV (Check memory datasheet)
CONFIG_DDR_TCL=18                 # CAS Latency
CONFIG_DDR_TRCD=18                # RAS-to-CAS Delay
CONFIG_DDR_TRP=18                 # RAS Precharge
CONFIG_DDR_TRAS=42                # Active to Precharge

#
# Memory Partitioning (ADJUST AS NEEDED)
#
CONFIG_BOOTLOADER_START=0x00000000
CONFIG_BOOTLOADER_SIZE=0x01000000   # 16MB
CONFIG_UBOOT_ENV_START=0x01000000
CONFIG_UBOOT_ENV_SIZE=0x01000000    # 16MB
CONFIG_KERNEL_START=0x02000000
CONFIG_KERNEL_SIZE=0x0E000000       # 224MB
CONFIG_DTB_START=0x10000000
CONFIG_DTB_SIZE=0x01000000          # 16MB
CONFIG_RESERVED_START=0x11000000
CONFIG_RESERVED_SIZE=0x0F000000     # 240MB

# NPU Memory Pool (ENABLE/DISABLE BASED ON NEEDS)
CONFIG_NPU_MEMORY_START=0x20000000
CONFIG_NPU_MEMORY_SIZE=0x08000000   # 128MB (Adjust for your needs)

# GPU Memory Pool
CONFIG_GPU_MEMORY_START=0x28000000
CONFIG_GPU_MEMORY_SIZE=0x08000000   # 128MB

# VPU/Camera Buffers
CONFIG_VPU_MEMORY_START=0x30000000
CONFIG_VPU_MEMORY_SIZE=0x10000000   # 256MB

# System RAM (ADJUST FOR TOTAL RAM)
CONFIG_SYSTEM_RAM_START=0x40000000
CONFIG_SYSTEM_RAM_SIZE=0x40000000   # 1GB (Adjust based on total RAM)

#
# NPU Configuration (ENABLE/DISABLE)
#
CONFIG_NPU_ENABLE=y                 # y/n
CONFIG_NPU_MODEL_STORAGE=0x04000000   # 64MB
CONFIG_NPU_INPUT_BUFFERS=0x01000000   # 16MB
CONFIG_NPU_OUTPUT_BUFFERS=0x01000000  # 16MB
CONFIG_NPU_SCRATCH_SPACE=0x02000000   # 32MB

#
# GPU Configuration
#
CONFIG_GPU_ENABLE=y                 # y/n
CONFIG_GPU_FREQ_MAX=800
CONFIG_GPU_FREQ_MIN=200
CONFIG_GPU_MEMORY_POOL=y

#
# VPU Configuration (ENABLE/DISABLE)
#
CONFIG_VPU_ENABLE=y                 # y/n
CONFIG_VPU_4K_SUPPORT=y
CONFIG_VPU_H265_SUPPORT=y
CONFIG_VPU_H264_SUPPORT=y

#
# Peripheral Support (ENABLE/DISABLE BASED ON HARDWARE)
#
CONFIG_SATA_ENABLE=y                # y/n
CONFIG_M2_PCIE_ENABLE=y             # y/n
CONFIG_GBE_ENABLE=y                 # y/n
CONFIG_USB3_ENABLE=y                # y/n
CONFIG_USB2_ENABLE=y                # y/n
CONFIG_ZIGBEE_SUPPORT=y             # y/n
CONFIG_Z_WAVE_SUPPORT=y             # y/n
CONFIG_MIPI_CSI_SUPPORT=y           # y/n
CONFIG_HDMI_IN_SUPPORT=y            # y/n
CONFIG_GPIO_EXTENDED=y              # y/n

# Custom peripherals
# CONFIG_CUSTOM_GPIO=y               # Uncomment if needed
# CONFIG_CUSTOM_SPI=y
# CONFIG_CUSTOM_I2C=y

#
# Security Features (ENABLE/DISABLE)
#
CONFIG_SECURE_BOOT_ENABLE=y         # y/n
CONFIG_TRUSTZONE_ENABLE=y           # y/n
CONFIG_MEMORY_ENCRYPTION=y          # y/n
CONFIG_SECURE_MEMORY_REGIONS=y      # y/n

#
# Power Management
#
CONFIG_POWER_MANAGEMENT=y
CONFIG_DYNAMIC_FREQ_SCALING=y
CONFIG_VOLTAGE_SCALING=y
CONFIG_POWER_GATING=y
CONFIG_THERMAL_MONITORING=y
CONFIG_FAN_CONTROL=n                # y if hardware has fan

#
# Debug Features
#
CONFIG_DEBUG_ENABLE=y
CONFIG_MEMORY_LOGGING=y
CONFIG_PERFORMANCE_MONITORING=y
CONFIG_MEMORY_TRACE=y

#
# Application Profiles (SELECT BASED ON USE CASE)
#
# Home Assistant profile
CONFIG_PROFILE_HOME_ASSISTANT=y

# NVR/Security profile
CONFIG_PROFILE_NVR=y

# AI/Edge Computing profile
CONFIG_PROFILE_AI_EDGE=y

# Development profile
CONFIG_PROFILE_DEVELOPMENT=y

# Custom profile
# CONFIG_PROFILE_CUSTOM=y

#
# Build Options
#
CONFIG_BUILD_TYPE="release"        # release/debug
CONFIG_OPTIMIZATION_LEVEL=2        # 0-3
CONFIG_DEBUG_SYMBOLS=n            # y/n
CONFIG_STRIP_BINARY=y             # y/n

#
# File System Support
#
CONFIG_ROOTFS_TYPE="ext4"          # ext4/f2fs/btrfs
CONFIG_BOOTFS_TYPE="vfat"
CONFIG_UBIFS_SUPPORT=y
CONFIG_BTRFS_SUPPORT=n
CONFIG_F2FS_SUPPORT=y

#
# Networking
#
CONFIG_WIRELESS_SUPPORT=y
CONFIG_BLUETOOTH_SUPPORT=y
CONFIG_ETH_SUPPORT=y
CONFIG_WIFI_FIRMWARE=y
CONFIG_5G_SUPPORT=n                # y if 5G module present

#
# Video/Audio
#
CONFIG_AUDIO_SUPPORT=y
CONFIG_HDMI_AUDIO=y
CONFIG_SPDIF_AUDIO=n

#
# Miscellaneous
#
CONFIG_SERIAL_CONSOLE="ttyS2"      # Change based on hardware
CONFIG_BAUDRATE=1500000
CONFIG_CMD_LINE="console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=/dev/mmcblk0p5 rw rootwait"

# Custom configuration (ADD YOUR OWN)
# CONFIG_CUSTOM_PARAMETER="value"
