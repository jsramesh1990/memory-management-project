# Radxa ROCK 3B Board Configuration
# RK3568 DDR Memory Manager
# Version: 1.0.0
# Date: 2024-08-06

#
# Board Information
#
CONFIG_BOARD_NAME="Radxa ROCK 3B"
CONFIG_BOARD_VENDOR="Radxa"
CONFIG_BOARD_MODEL="ROCK 3B"
CONFIG_BOARD_REVISION="v1.1"

#
# SoC Configuration
#
CONFIG_SOC="RK3568"
CONFIG_ARCH="ARM64"
CONFIG_CPU_TYPE="Cortex-A55"
CONFIG_CPU_CORES=4
CONFIG_CPU_FREQ_MAX=2000
CONFIG_CPU_FREQ_MIN=408

#
# Memory Configuration
#
CONFIG_DDR_TYPE="DDR4"
CONFIG_DDR_SIZE=8192              # 8GB
CONFIG_DDR_CHANNELS=2             # Dual-channel
CONFIG_DDR_FREQ=1600              # MHz
CONFIG_DDR_VOLTAGE=1200           # mV
CONFIG_DDR_TCL=16
CONFIG_DDR_TRCD=16
CONFIG_DDR_TRP=16
CONFIG_DDR_TRAS=36

#
# Memory Partitioning
#
CONFIG_BOOTLOADER_START=0x00000000
CONFIG_BOOTLOADER_SIZE=0x01000000   # 16MB
CONFIG_UBOOT_ENV_START=0x01000000
CONFIG_UBOOT_ENV_SIZE=0x01000000    # 16MB
CONFIG_KERNEL_START=0x02000000
CONFIG_KERNEL_SIZE=0x0E000000       # 224MB
CONFIG_DTB_START=0x10000000
CONFIG_DTB_SIZE=0x01000000          # 16MB
CONFIG_RESERVED_START=0x11000000
CONFIG_RESERVED_SIZE=0x0F000000     # 240MB

# NPU Memory Pool (Larger for 8GB RAM)
CONFIG_NPU_MEMORY_START=0x20000000
CONFIG_NPU_MEMORY_SIZE=0x10000000   # 256MB

# GPU Memory Pool
CONFIG_GPU_MEMORY_START=0x30000000
CONFIG_GPU_MEMORY_SIZE=0x10000000   # 256MB

# VPU/Camera Buffers
CONFIG_VPU_MEMORY_START=0x40000000
CONFIG_VPU_MEMORY_SIZE=0x20000000   # 512MB

# System RAM (Remaining 7GB)
CONFIG_SYSTEM_RAM_START=0x60000000
CONFIG_SYSTEM_RAM_SIZE=0x1C0000000  # 7GB

#
# NPU Configuration
#
CONFIG_NPU_ENABLE=y
CONFIG_NPU_MODEL_STORAGE=0x08000000   # 128MB
CONFIG_NPU_INPUT_BUFFERS=0x02000000   # 32MB
CONFIG_NPU_OUTPUT_BUFFERS=0x02000000  # 32MB
CONFIG_NPU_SCRATCH_SPACE=0x04000000   # 64MB

#
# GPU Configuration
#
CONFIG_GPU_ENABLE=y
CONFIG_GPU_FREQ_MAX=800
CONFIG_GPU_FREQ_MIN=200
CONFIG_GPU_MEMORY_POOL=y

#
# VPU Configuration
#
CONFIG_VPU_ENABLE=y
CONFIG_VPU_4K_SUPPORT=y
CONFIG_VPU_H265_SUPPORT=y
CONFIG_VPU_H264_SUPPORT=y

#
# Peripheral Support
#
CONFIG_SATA_ENABLE=y
CONFIG_M2_PCIE_ENABLE=y
CONFIG_GBE_ENABLE=y
CONFIG_USB3_ENABLE=y
CONFIG_USB2_ENABLE=y
CONFIG_ZIGBEE_SUPPORT=y
CONFIG_Z_WAVE_SUPPORT=y
CONFIG_MIPI_CSI_SUPPORT=y      # Camera support
CONFIG_HDMI_IN_SUPPORT=y       # HDMI input support

#
# Security Features
#
CONFIG_SECURE_BOOT_ENABLE=y
CONFIG_TRUSTZONE_ENABLE=y
CONFIG_MEMORY_ENCRYPTION=y
CONFIG_SECURE_MEMORY_REGIONS=y

#
# Power Management
#
CONFIG_POWER_MANAGEMENT=y
CONFIG_DYNAMIC_FREQ_SCALING=y
CONFIG_VOLTAGE_SCALING=y
CONFIG_POWER_GATING=y
CONFIG_THERMAL_MONITORING=y

#
# Debug Features
#
CONFIG_DEBUG_ENABLE=y
CONFIG_MEMORY_LOGGING=y
CONFIG_PERFORMANCE_MONITORING=y
CONFIG_MEMORY_TRACE=y
CONFIG_JTAG_DEBUG=y

#
# Application Profiles
#
CONFIG_PROFILE_HOME_ASSISTANT=y
CONFIG_PROFILE_NVR=y
CONFIG_PROFILE_AI_EDGE=y
CONFIG_PROFILE_DEVELOPMENT=y

#
# Build Options
#
CONFIG_BUILD_TYPE="release"
CONFIG_OPTIMIZATION_LEVEL=2
CONFIG_DEBUG_SYMBOLS=n
CONFIG_STRIP_BINARY=y

#
# File System Support
#
CONFIG_ROOTFS_TYPE="ext4"
CONFIG_BOOTFS_TYPE="vfat"
CONFIG_UBIFS_SUPPORT=y
CONFIG_BTRFS_SUPPORT=y          # For advanced storage

#
# Networking
#
CONFIG_WIRELESS_SUPPORT=y
CONFIG_BLUETOOTH_SUPPORT=y
CONFIG_ETH_SUPPORT=y
CONFIG_WIFI_FIRMWARE=y

#
# Miscellaneous
#
CONFIG_SERIAL_CONSOLE="ttyS2"
CONFIG_BAUDRATE=1500000
CONFIG_CMD_LINE="console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=/dev/mmcblk0p5 rw rootwait"
