# Dockerfile for ARM64 Native Build Environment
# For running directly on ARM64 hardware
# Version: 1.0.0
# Author: Sebastian

FROM arm64v8/ubuntu:22.04

# Set metadata
LABEL maintainer="sebastian@example.com"
LABEL description="ARM64 Native Build Environment for RK3568 DDR Memory Manager"
LABEL version="1.0.0"

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ARCH=arm64

# Install packages
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    autoconf \
    automake \
    libtool \
    pkg-config \
    # Python
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    # Git
    git \
    git-lfs \
    # Device tree
    device-tree-compiler \
    u-boot-tools \
    # Kernel
    linux-headers-generic \
    # Debugging
    gdb \
    strace \
    ltrace \
    valgrind \
    # System tools
    curl \
    wget \
    vim \
    tmux \
    htop \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    pytest \
    pyyaml \
    click \
    tqdm

# Create build directories
RUN mkdir -p /workspace /build /output

# Set up user
RUN useradd -m -u 1000 -s /bin/bash developer \
    && echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER developer
WORKDIR /home/developer

# Default command
CMD ["/bin/bash"]
