# Dockerfile for RK3568 DDR Memory Manager Testing Environment
# Automated testing container
# Version: 1.0.0
# Author: Sebastian

FROM ubuntu:22.04

# Set metadata
LABEL maintainer="sebastian@example.com"
LABEL description="RK3568 DDR Memory Manager Testing Environment"
LABEL version="1.0.0"

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONPATH=/workspace

# Install base packages
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc-arm-linux-gnueabihf \
    g++-arm-linux-gnueabihf \
    binutils-arm-linux-gnueabihf \
    make \
    cmake \
    autoconf \
    automake \
    libtool \
    pkg-config \
    # Python
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    # Git
    git \
    git-lfs \
    # Device tree
    device-tree-compiler \
    u-boot-tools \
    # Testing tools
    expect \
    dejagnu \
    qemu-system-arm \
    # Coverage
    lcov \
    gcovr \
    # System tools
    curl \
    wget \
    stress \
    sysstat \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for testing
RUN pip3 install --no-cache-dir \
    # Testing frameworks
    pytest \
    pytest-cov \
    pytest-xdist \
    pytest-timeout \
    pytest-html \
    # Code quality
    flake8 \
    pylint \
    black \
    mypy \
    # Coverage
    coverage \
    codecov \
    # Utilities
    pyyaml \
    json5 \
    click \
    # Mocking
    mock \
    pytest-mock \
    # Performance
    locust \
    # Security
    bandit \
    safety

# Create test directories
RUN mkdir -p /workspace /test-results /coverage

# Set up test user
RUN useradd -m -u 1000 -s /bin/bash tester \
    && echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to tester
USER tester
WORKDIR /workspace

# Test entrypoint script
RUN echo '#!/bin/bash\n\
    echo "=== RK3568 DDR Memory Manager Test Suite ===\n\
    echo "Running tests...\n\
    pytest /workspace/tests -v --cov=/workspace/src --cov-report=html:/test-results/coverage\n\
    echo "Tests complete. Results in /test-results/"' > /home/tester/run_tests.sh \
    && chmod +x /home/tester/run_tests.sh

# Default command
CMD ["/home/tester/run_tests.sh"]
